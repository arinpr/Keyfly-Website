// keyfly.si: the static export in out/, served by Cloudflare Workers static
// assets, behind a tiny worker that 301s www to the apex. It replaces the
// earlier one-page site under the same Worker name and the same routes, so
// DNS, app.keyfly.si and email are untouched. Deploy with `pnpm run deploy`
// or the GitHub workflow.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyfly-site",
  "account_id": "edeacb7be689a7f4d1e360d944358c1b",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "keyfly.si/*", "zone_name": "keyfly.si" },
    { "pattern": "www.keyfly.si/*", "zone_name": "keyfly.si" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
